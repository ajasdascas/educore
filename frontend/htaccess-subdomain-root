# EduCore — Wildcard Subdomain Router v2
# Upload this file as .htaccess to the ROOT of public_html (NOT inside /educore/)
#
# ONE-TIME SETUP (done once, applies to ALL schools forever):
#   1. DNS panel: *.onlineu.mx  →  A  →  [same IP as onlineu.mx]
#   2. Hostinger hPanel → Hosting → cPanel → Domains → Subdomains:
#      Subdomain: *  |  Domain: onlineu.mx  |  Root: public_html/
#   3. This .htaccess is auto-deployed via GitHub Actions on every push to master.
#
# BEHAVIOR per path on {slug}.onlineu.mx:
#   /                            → /educore/escuela/?slug={slug}         (portal selector)
#   /login?role=X                → /educore/login?slug={slug}&role=X     (login page)
#   /login                       → /educore/login?slug={slug}            (login, no role)
#   /escuela/                    → /educore/escuela/?slug={slug}         (explicit portal)
#   /school-admin/...            → /educore/school-admin/...             (app, JWT handles auth)
#   anything else                → /educore/{path}?{original-query}      (passthrough)

RewriteEngine On

# ── Skip main domain — no rewrite needed ──────────────────────────────────────
RewriteCond %{HTTP_HOST} ^(www\.)?onlineu\.mx$ [NC]
RewriteRule ^ - [L]

# ── Exclude system subdomains ─────────────────────────────────────────────────
# (applied to all rules below via shared ENV flag)
RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.onlineu\.mx$ [NC]
RewriteCond %1 ^(www|mail|ftp|api|smtp|webmail|admin|dev|staging|cpanel|webdisk)$ [NC]
RewriteRule ^ - [L]

# ─────────────────────────────────────────────────────────────────────────────
# RULE 1: Root path (/) → portal selector
# kinder1.onlineu.mx  →  https://onlineu.mx/educore/escuela/?slug=kinder1
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.onlineu\.mx$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^ https://onlineu.mx/educore/escuela/?slug=%1 [R=302,L]

# ─────────────────────────────────────────────────────────────────────────────
# RULE 2: /login path → inject slug into login URL
# kinder1.onlineu.mx/login?role=school_admin
#   → https://onlineu.mx/educore/login?slug=kinder1&role=school_admin
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.onlineu\.mx$ [NC]
RewriteCond %{REQUEST_URI} ^/login$ [NC]
RewriteCond %{QUERY_STRING} .+
RewriteRule ^ https://onlineu.mx/educore/login?slug=%1&%{QUERY_STRING} [R=302,L,QSD]

# /login with no query string
RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.onlineu\.mx$ [NC]
RewriteCond %{REQUEST_URI} ^/login$ [NC]
RewriteRule ^ https://onlineu.mx/educore/login?slug=%1 [R=302,L]

# ─────────────────────────────────────────────────────────────────────────────
# RULE 3: /escuela/ path → portal selector (in case user navigates to it directly)
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.onlineu\.mx$ [NC]
RewriteCond %{REQUEST_URI} ^/escuela/? [NC]
RewriteRule ^ https://onlineu.mx/educore/escuela/?slug=%1 [R=302,L,QSD]

# ─────────────────────────────────────────────────────────────────────────────
# RULE 4: All other paths → passthrough to educore with original query string
# kinder1.onlineu.mx/school-admin/dashboard
#   → https://onlineu.mx/educore/school-admin/dashboard
# (JWT token in localStorage handles tenant auth — no slug injection needed)
# ─────────────────────────────────────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.onlineu\.mx$ [NC]
RewriteRule ^/?(.+)$ https://onlineu.mx/educore/$1 [R=302,L,QSA]
