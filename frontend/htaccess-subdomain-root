# EduCore school-subdomain router (alternative public_html-root topology).
#
# Use this file only when Hostinger maps *.onlineu.mx to:
#   /home/u550473909/domains/onlineu.mx/public_html
#
# It must be MERGED into the existing public_html/.htaccess; do not overwrite
# unrelated rules for the main onlineu.mx website. The recommended topology is
# documented in docs/AUTOMATIC_SCHOOL_SUBDOMAINS.md and uses the router shipped
# automatically inside /public_html/educore instead.

RewriteEngine On

# Main platform and infrastructure hosts are never tenant routes.
RewriteCond %{HTTP_HOST} ^(?:www\.)?onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^ - [END]

RewriteCond %{HTTP_HOST} ^(?:www|api|mail|ftp|smtp|webmail|admin|dashboard|app|educore|onlineu|support|status|static|assets|cdn|dev|staging|cpanel|webdisk|portal|login|auth|public|ns1|ns2|mx)\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^ - [END]

# /educore is the real static application directory in this topology.
RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^educore(?:/|$) - [END]

RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^$ /educore/escuela/ [R=302,END,NE,QSA]

RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^login/?$ /educore/login/ [R=302,END,NE,QSA]

RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^escuela/?$ /educore/escuela/ [R=302,END,NE,QSA]

RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^(.+)$ /educore/$1 [R=302,END,NE,QSA]
