# EduCore school-subdomain router for Hostinger/LiteSpeed shared hosting.
#
# This file is copied to frontend/out/.htaccess after every production build.
# Every school subdomain created through the Hostinger API MUST use this
# shared document root:
#   /home/u550473909/domains/onlineu.mx/public_html/educore
#
# The static export was built with basePath=/educore. On the main domain this
# directory is reached as /educore/. On a school subdomain this same directory
# is the vhost document root, so requests for /educore/* need the prefix removed
# internally before Apache/LiteSpeed resolves the file.

Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Never treat the platform hosts as school tenants.
RewriteCond %{HTTP_HOST} ^(?:www\.)?onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^ - [END]

RewriteCond %{HTTP_HOST} ^(?:www|api|mail|ftp|smtp|webmail|admin|dashboard|app|educore|onlineu|support|status|static|assets|cdn|dev|staging|cpanel|webdisk|portal|login|auth|public|ns1|ns2|mx)\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^ - [END]

# Requests generated by Next.js include /educore. Strip it only for filesystem
# lookup on the school vhost; the browser keeps the correct public URL.
RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^educore/?$ . [END]

RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^educore/(.+)$ $1 [END]

# Friendly school entry point. Tenant identity comes from the hostname, not
# from a user-controlled query parameter.
RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^$ /educore/escuela/ [R=302,END,NE,QSA]

# Backward-compatible links without the production basePath.
RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^login/?$ /educore/login/ [R=302,END,NE,QSA]

RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^escuela/?$ /educore/escuela/ [R=302,END,NE,QSA]

RewriteCond %{HTTP_HOST} ^(?![a-z0-9-]*--)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])\.onlineu\.mx(?::[0-9]+)?$ [NC]
RewriteRule ^(.+)$ /educore/$1 [R=302,END,NE,QSA]
