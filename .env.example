# EduCore — Variables de Entorno
# Copia este archivo como .env y rellena los valores

# ──────────────────────────────
# SERVIDOR
# ──────────────────────────────
# En dev el backend escucha 8082 (coincide con el fallback del frontend y start-dev.sh).
# En producción NO fijes PORT: la plataforma (Railway) lo provee y el backend lo usa.
PORT=8082
APP_ENV=development
ENVIRONMENT=development
APP_NAME=EduCore
# URL publica exacta del frontend usada para enlaces de recuperacion.
# Produccion: https://onlineu.mx/educore (HTTPS obligatorio fuera de localhost).
APP_BASE_URL=http://localhost:3000

# ──────────────────────────────
# BASE DE DATOS
# ──────────────────────────────
# PRODUCCIÓN: PostgreSQL en Neon (DB_DRIVER=postgres, DATABASE_URL con ?sslmode=require).
# El backend en Render usa estas variables como secrets del servicio.
DB_DRIVER=postgres
DATABASE_URL=postgres://educore:educore_dev_password@localhost:5432/educore_dev?sslmode=disable
# ⛔ NO ACTIVO: MySQL de Hostinger fue un puente histórico. NO usar en producción.
# No definir MYSQL_DSN ni EDUCORE_ALLOW_MYSQL_RUNTIME en el backend productivo.
MYSQL_DSN=
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
ALLOW_DEMO_LOGIN=false

# Bootstrap create-once del owner admin. En una base nueva se activa solo para
# el primer arranque y luego se vuelve a false y se retira la contraseña.
# Nunca modifica, reactiva ni restablece una cuenta existente.
EDUCORE_AUTO_SEED_OWNERS=false

# URL PÚBLICA del backend (NO es secreto; se hornea en el build estático).
#   - Dev: http://localhost:8082
#   - Prod: la URL real del backend (https://...). Se pasa como secret/variable
#     del build (GitHub Secret NEXT_PUBLIC_API_URL), NUNCA una URL de Railway vieja.
# Nunca pongas secretos en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8082
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_PASSWORD=
# Endpoint publico opcional para solicitudes de demo (solo HTTPS, nunca un secreto).
# Si se deja vacio, la portada prepara un correo a contacto@onlineu.mx.
NEXT_PUBLIC_DEMO_FORM_ENDPOINT=

# Webhook opcional de GitHub para historial de versiones. Ambos valores son
# backend-only; si falta cualquiera, el endpoint responde 503.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_REPOSITORY=

# ──────────────────────────────
# DESPLIEGUE (estos van como GitHub Secrets, NO en .env versionado)
# ──────────────────────────────
# HOSTINGER_FTP_SERVER, HOSTINGER_FTP_USERNAME, HOSTINGER_FTP_PASSWORD
# HOSTINGER_FTP_TARGET_DIR (opcional, default /educore/; la raíz FTP ya es public_html)
# Provisión automática de un subdominio por escuela (Render y, para reintento manual, GitHub Actions):
HOSTINGER_API_TOKEN=
# Usuario de la CUENTA DE HOSTING que devuelve la API de Hostinger; no asumir que es el usuario FTP.
HOSTINGER_HOSTING_USERNAME=
HOSTINGER_WEBSITE_DOMAIN=onlineu.mx
# Directorio relativo a /domains/onlineu.mx/public_html que contiene el export estático.
HOSTINGER_SUBDOMAIN_DIRECTORY=educore

# ──────────────────────────────
# REDIS
# ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────
# JWT
# ──────────────────────────────
# Obligatorio en produccion: generar fuera del repositorio (por ejemplo,
# `openssl rand -base64 48`) y guardarlo solo en el secret store.
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ──────────────────────────────
# CORS
# ──────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ──────────────────────────────
# EMAIL (Resend)
# ──────────────────────────────
# Secret exclusivo del backend: no exponerlo como NEXT_PUBLIC_* ni versionarlo.
# Usa una API key de Resend con permiso solo de envio y un remitente/dominio verificado.
RESEND_API_KEY=
EMAIL_FROM=noreply@onlineu.mx
EMAIL_FROM_NAME=EduCore

# ──────────────────────────────
# STORAGE (local en dev, S3 en prod)
# ──────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# Para producción:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx
# AWS_REGION=us-east-1
# AWS_BUCKET=educore-prod

# ──────────────────────────────
# OBSIDIAN SYNC (opcional)
# ──────────────────────────────
# OBSIDIAN_VAULT_PATH=/Users/tu_usuario/Documents/Obsidian/EduCore

# ──────────────────────────────
# SUPER ADMIN (se crea en seed)
# ──────────────────────────────
SUPER_ADMIN_EMAIL=admin@educore.mx
SUPER_ADMIN_PASSWORD=cambiar_en_produccion
EDUCORE_OWNER_ADMIN_EMAILS=gioescudero2007@gmail.com,jagustin_ramosp@hotmail.com
EDUCORE_OWNER_ADMIN_PASSWORD=
