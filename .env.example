# EduCore — Variables de Entorno
# Copia este archivo como .env y rellena los valores

# ──────────────────────────────
# SERVIDOR
# ──────────────────────────────
PORT=8080
APP_ENV=development
ENVIRONMENT=development
APP_NAME=EduCore

# ──────────────────────────────
# BASE DE DATOS
# ──────────────────────────────
DB_DRIVER=postgres
DATABASE_URL=postgres://educore:educore_dev_password@localhost:5432/educore_dev?sslmode=disable
# Puente temporal Hostinger MySQL/phpMyAdmin. Usar solo con Remote MySQL por IP allowlist.
# Formato: user:password@tcp(host:3306)/database?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci
MYSQL_DSN=
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
ALLOW_DEMO_LOGIN=false

# Frontend static export. En produccion debe ser false para no incluir logins demo.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_PASSWORD=

# ──────────────────────────────
# REDIS
# ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────
# JWT
# ──────────────────────────────
JWT_SECRET=tu-secret-aqui-cambialo-en-produccion-minimo-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ──────────────────────────────
# CORS
# ──────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ──────────────────────────────
# EMAIL (Resend) — ver docs/AUTH_EMAIL_SETUP.md
# ──────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@educore.mx
EMAIL_FROM_NAME=EduCore
# Override específico para emails de reset (usa EMAIL_FROM si no se define)
PASSWORD_RESET_FROM_EMAIL=
# URL pública del frontend (para el link en el email de reset)
PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────
# STORAGE (local en dev, S3 en prod)
# ──────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# Para producción:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx
# AWS_REGION=us-east-1
# AWS_BUCKET=educore-prod

# ──────────────────────────────
# BACKUPS (Super Admin — Cloudflare R2 o S3)
# ──────────────────────────────
# Habilitar backups automáticos: "r2" o "s3"
# BACKUP_STORAGE_PROVIDER=r2
#
# Credenciales R2 (Cloudflare):
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=educore-backups
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=<R2 Access Key ID>
# BACKUP_S3_SECRET_ACCESS_KEY=<R2 Secret Access Key>
#
# (Credenciales AWS S3 — igual pero sin BACKUP_S3_ENDPOINT)
#
# Override de ruta mysqldump si no está en PATH:
# MYSQLDUMP_PATH=/usr/local/bin/mysqldump

# ──────────────────────────────
# OBSIDIAN SYNC (opcional)
# ──────────────────────────────
# OBSIDIAN_VAULT_PATH=/Users/tu_usuario/Documents/Obsidian/EduCore

# ──────────────────────────────
# SUPER ADMIN (se crea en seed)
# ──────────────────────────────
SUPER_ADMIN_EMAIL=admin@educore.mx
SUPER_ADMIN_PASSWORD=cambiar_en_produccion
EDUCORE_DEFAULT_SCHOOL_ADMIN_PASSWORD=cambiar_esta_password_segura
EDUCORE_OWNER_ADMIN_EMAILS=gioescudero2007@gmail.com,jagustin_ramosp@hotmail.com
EDUCORE_OWNER_ADMIN_PASSWORD=
